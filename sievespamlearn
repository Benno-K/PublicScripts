#!/bin/sh
# $1 ist entweder "spam" oder "ham"
ACTION=${1:-spam}
MAILUSER="${RECIPIENT:-unknown}"

if /usr/bin/rspamc learn_$ACTION; then
    logger -p mail.info -t dovecot-rspamd "SUCCESS: learned $ACTION for $MAILUSER"
else
    logger -p mail.err -t dovecot-rspamd "FAIL: learning $ACTION for $MAILUSER"
fi
